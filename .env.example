# Copy to .env for local runs. In CI these are GitHub Secrets.
# Never commit real values here, private repository or not: git history is
# permanent, and a project reference is not something to publish either.

# Supabase Postgres connection string (session or pooler URI).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT-REF.supabase.co:5432/postgres

# Telegram bot token from @BotFather.
TELEGRAM_TOKEN=

# Chat id of the private ops channel that receives failure and repair alerts.
TELEGRAM_OPS_CHAT=

# ── the Telegram feed reader (`python -m worker ingest`) ──────────────────
#
# Only needed on the host that runs the reader. Telethon is an optional extra:
# `uv sync --extra ingest`. A host that only scrapes needs none of this.

# From https://my.telegram.org -> API development tools. Not a bot token.
TG_API_ID=
TG_API_HASH=
# Printed once by `python tools/tg-mirror/mirror.py login`. A live login to the
# account: treat it as a password and keep it out of the repository.
TG_SESSION=
# Which chat to read, without the @. Comma-separated for more than one. Required:
# there is deliberately no default, so a third party's handle is never in the code.
TG_WATCH=
# Names this reader. The cursor in `ingest_cursors` and the per-reader uniqueness on
# `source_messages` are both keyed by it, so a second account MUST use a different
# name — two hosts sharing one would each skip what the other read.
TG_READER=
# Names to scrub out of stored message bodies, comma-separated. The feed signs every
# message with its own brand; that name is no use to the parser and has no business
# in the database or its backups. Replaced with "hs".
TG_REDACT=

# Anthropic API key. Used only when an extraction schema must be inferred or
# repaired, so consumption is event-driven rather than per-listing.
ANTHROPIC_API_KEY=

# Optional. A link back to the run that produced a row in job_runs. Set by the
# scheduler that invokes the worker; absent when running locally.
RUN_URL=


# ── the admin console ─────────────────────────────────────────────────────
# Generate both with:  node scripts/admin-hash.mjs '<your password>'
#
# ADMIN_PASSWORD_HASH is a scrypt hash, not the password — the password itself is
# never stored anywhere, including here. Without it the console has no way in,
# which is the safe direction for a missing secret to fail in.
ADMIN_PASSWORD_HASH=
# Signs the session cookie AND salts the visitor and login-attempt hashes. At
# least 32 characters. Changing it signs everybody out and makes yesterday's
# visitor hashes unrelated to today's, which is harmless.
ADMIN_SESSION_SECRET=
