# Supabase connection string. Use the pooled (port 6543) one: serverless functions
# open a connection per invocation, and the direct port runs out of them.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

TELEGRAM_TOKEN=
# Without the @. Used to build the t.me link the form redirects to.
TELEGRAM_BOT_USERNAME=london_rent_alerts_bot
# Any long random string. Passed to setWebhook and checked on every update, so
# that only Telegram can post to the webhook route.
TELEGRAM_WEBHOOK_SECRET=

# Where this app is reachable. Used in the links the bot sends and by the worker's
# plan-expiry message, so set it in both places.
SITE_URL=https://london-rent-alerts.vercel.app

# The one chat allowed to run /grant. Your own chat id.
TELEGRAM_ADMIN_CHAT=

# Bank-transfer route: a payment link people can open (revolut.me/…, monzo.me/…).
# Payments arriving this way have to be granted by hand with /grant in the bot,
# because these links have no webhook.
PAYMENT_LINK=

# Card route, optional. With both of these set, /upgrade shows a card button.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Which row in `plans` a card payment grants. Defaults to 'paid'.
STRIPE_PLAN_KEY=paid
