[Unit]
Description=London Home Finder: the headless browser's ceiling
Before=slices.target

# The one resource limit on this box, and the reason it exists.
#
# Nothing else here has ever been able to exhaust the machine: the readers are
# Python processes holding a 60KB page, Postgres is in Supabase and the web app
# is on Vercel, so 2 vCPU and 4 GB have been ample and no unit has ever carried
# a limit. Chromium is the first thing that can, and the failure mode without a
# cap is not "the browser is slow" — it is the OOM killer choosing a victim by
# its own arithmetic, which on a box whose only other processes are the
# scrapers means a scrape dies so a mint can finish.
#
# So the browser is confined and the scrapers are not, which is the right way
# round: the browser is the optional half. If it cannot fit, the readers carry
# on being challenged, which is exactly where they were before it existed.
[Slice]
# 2 GB. A single Chromium page load peaks around 400-500 MB, so this is a
# safety net rather than a working limit — and it must stay equal to
# `BROWSER_CAP` in apps/web/app/admin/(dash)/host/health.ts, which colours the
# Host tab's tiles as a proportion of it.
MemoryMax=2G
# Pressure before the wall: the kernel reclaims hard from this slice once it
# passes here, which for a browser means dropping caches it can refetch rather
# than being killed outright. A mint that takes an extra two seconds is a mint;
# a mint that is killed is nothing.
MemoryHigh=1G
# One of the two processors. The challenge is a few seconds of JavaScript and
# it has no business being all of the machine while a scrape is running.
CPUQuota=100%
# A browser is a dozen processes and no more. Without this a runaway renderer
# loop can exhaust the pid namespace, which is a different way to take the box
# down and is not covered by any memory limit.
TasksMax=256
