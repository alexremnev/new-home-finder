# SpareRoom, read as a rotating window over the search ranking.
#
# Costs about 186KB a run and none of it is billed: this reader is pinned to
# the direct route in code — `SpareRoom.direct_only`, via `sweep._pin_direct` —
# because the site serves this server every page. So a tighter schedule here
# buys latency for nothing but bandwidth.
#
# ── the schedule, in London time ─────────────────────────────────────────
#
#   every day  00:00–07:00   hourly
#   weekdays   08:00–18:00   every 6 minutes
#   weekdays   07:00–08:00   every 12 minutes
#   weekdays   18:00–24:00   every 12 minutes
#   weekends   07:00–24:00   every 12 minutes
#
# These are `rightmove`'s bands exactly, which is the point: the four readers
# that go out over the network run at one cadence.
#
# Each band's stated end is exclusive, so the last six-minute run is 17:58:30
# and 18:00 belongs to the twelve-minute band that follows.
#
# ── what the extra runs buy here, and it is not more stock ───────────────
#
# This reader pages through a rotating window rather than reading newest-first:
# `WINDOW` pages of ranking, `PAGES_PER_RUN` a run, moving on one slice each
# time, because robots.txt forbids the sort order that would make a watermark
# possible. See the module note in worker/sources/spareroom.py.
#
# So a run is a slice of a cycle, and the cycle is what the latency is made of:
# 10 runs to walk the window, which is 60 minutes in the weekday band. It was
# 50 on the five-minute grid, and the ten extra minutes are the whole of what
# the six-minute grid costs this reader.
#
# The slice is taken from the clock in `spareroom.SLOT_SECONDS` buckets, not
# from a counter, so the offset below cannot desynchronise it: a run at 4m30s
# past a boundary falls in the same bucket as the boundary, and consecutive
# runs get consecutive slices. With the 15s delay the worst draw lands at
# 4m45s, still 75 seconds inside that bucket.
#
# That constant and this interval have to agree, and the reason is worth
# stating because it fails quietly. At 300 seconds against a 360-second
# cadence every slice is still visited — simulated over 200 runs — but
# unevenly, four slices getting 24 visits and the other six 16, because the
# bucket index advances 1,1,1,1,2 across every five runs. Nothing is lost, the
# cycle is just lumpy. `SLOT_SECONDS` is 360 so that it is not.
#
# ── the offset, and why it is seconds and not minutes ────────────────────
#
# Four readers, one grid, evenly spaced: `rightmove` on the boundary,
# `zoopla_london` a quarter of the interval later, `onthemarket` half, this one
# three quarters. Three quarters of six minutes is 4m30s, which is why the
# six-minute line below carries a seconds component; the twelve-minute band
# divides into whole minutes.
#
#   six-minute band     :04 at second 30   → 4m30s after rightmove
#   twelve-minute band  :09                → 9m after rightmove
#   hourly night band   :45                → 45m after rightmove
#
# ── the zone is stated here, not taken from the machine ──────────────────
#
# Every line carries `Europe/London`. Without it systemd reads OnCalendar in
# whatever zone the machine happens to be in: the server runs on UTC, so the
# schedule would sit an hour early through British Summer Time, quietly correct
# itself in October and break again in March.
#
# Needs systemd 252 or later. Check a line with
#
#     systemd-analyze calendar 'Mon..Fri 08..17:04/6:30 Europe/London'

[Unit]
Description=Read the whole of SpareRoom London as a rotating window

[Timer]
Unit=london-home-finder@spareroom.service

# Nights, every day including weekends: hourly, 00:45 to 07:00.
OnCalendar=*-*-* 00..06:45 Europe/London

# Weekdays, the working day: every six minutes, 08:00 to 18:00.
OnCalendar=Mon..Fri 08..17:04/6:30 Europe/London

# Weekdays, the hour before the working day and the evening after it: every
# twelve minutes. Two lines because the morning band is a single hour — folded
# into `07..17` it would make 07:00–08:00 six-minutely too.
OnCalendar=Mon..Fri 07:09/12 Europe/London
OnCalendar=Mon..Fri 18..23:09/12 Europe/London

# Weekends, from the end of the night band to midnight: every twelve minutes.
OnCalendar=Sat,Sun 07..23:09/12 Europe/London

# Fifteen seconds. Small enough to keep the spacing above and to stay inside
# this run's `SLOT_SECONDS` window slice. The per-request delay is
# `SCRAPE_JITTER`.
RandomizedDelaySec=15s
AccuracySec=15s

# Deliberately NOT Persistent. A missed run is a slice of the window skipped,
# which the next cycle reads anyway; firing on boot would start it off-grid.
Persistent=false

[Install]
WantedBy=timers.target
