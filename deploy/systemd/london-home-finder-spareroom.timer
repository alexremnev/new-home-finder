# SpareRoom, read as a rotating window over the search ranking.
#
# Costs about 186KB a run and none of it is billed: this reader is pinned to
# the direct route in code — `SpareRoom.direct_only`, via `sweep._pin_direct` —
# because the site serves this server every page. So a tighter schedule here
# buys latency for nothing but bandwidth.
#
# ── the schedule, in London time ─────────────────────────────────────────
#
#   every day  00:00–07:00   hourly
#   weekdays   08:00–18:00   every 5 minutes
#   weekdays   07:00–08:00   every 10 minutes
#   weekdays   18:00–24:00   every 10 minutes
#   weekends   07:00–24:00   every 10 minutes
#
# These are `rightmove`'s bands exactly, which is the point: the three readers
# that go out over the network now run at one cadence. It replaces a schedule
# that stopped at 21:00 weekdays and did not run overnight.
#
# Each band's stated end is exclusive, so the last five-minute run is 17:58:20
# and 18:00 belongs to the ten-minute band that follows.
#
# ── what the extra runs buy here, and it is not more stock ───────────────
#
# This reader pages through a rotating window rather than reading newest-first:
# `WINDOW` pages of ranking, `PAGES_PER_RUN` a run, moving on one slice each
# time, because robots.txt forbids the sort order that would make a watermark
# possible. See the module note in worker/sources/spareroom.py.
#
# So a run is a slice of a cycle, and the cycle is what the latency is made of:
# about 10 runs to walk the window, which was some 50 minutes on the old
# schedule and is the same 50 in the weekday band — the five-minute cadence
# there is unchanged. What the new bands add is the evening and the night,
# where the window used to step once a quarter hour and now steps once every
# ten minutes, and the overnight hours where it did not step at all.
#
# The slice is taken from the clock in 300-second buckets, not from a counter,
# so the offset below cannot desynchronise it: a run at 3m20s past a boundary
# falls in the same bucket as the boundary, and consecutive five-minute runs
# still get consecutive slices. With the 15s delay the worst draw lands at
# 3m35s, still 85 seconds inside that bucket.
#
# ── the offset, and why it is seconds and not minutes ────────────────────
#
# Three readers, one grid, evenly spaced: `rightmove` on the boundary,
# `zoopla_london` a third of the interval later, this one two thirds. Two
# thirds of five minutes is 3m20s, which is why the time fields below carry a
# seconds component — minute offsets cannot divide a five-minute interval into
# three equal parts.
#
#   five-minute band   :03 at second 20   → 3m20s after rightmove
#   ten-minute band    :06 at second 40   → 6m40s after rightmove
#   hourly night band  :40               → 40m after rightmove
#
# ── the zone is stated here, not taken from the machine ──────────────────
#
# Every line carries `Europe/London`. Without it systemd reads OnCalendar in
# whatever zone the machine happens to be in: the server runs on UTC, so the
# schedule would sit an hour early through British Summer Time, quietly correct
# itself in October and break again in March.
#
# Needs systemd 252 or later. Check a line with
#
#     systemd-analyze calendar 'Mon..Fri 08..17:03/5:20 Europe/London'

[Unit]
Description=Read the whole of SpareRoom London as a rotating window

[Timer]
Unit=london-home-finder@spareroom.service

# Nights, every day including weekends: hourly, 00:00 to 07:00.
OnCalendar=*-*-* 00..06:40 Europe/London

# Weekdays, the working day: every five minutes, 08:00 to 18:00.
OnCalendar=Mon..Fri 08..17:03/5:20 Europe/London

# Weekdays, the hour before the working day and the evening after it: every ten
# minutes. Two lines because the morning band is a single hour — folded into
# `07..17` it would make 07:00–08:00 five-minutely too.
OnCalendar=Mon..Fri 07:06/10:40 Europe/London
OnCalendar=Mon..Fri 18..23:06/10:40 Europe/London

# Weekends, from the end of the night band to midnight: every ten minutes.
OnCalendar=Sat,Sun 07..23:06/10:40 Europe/London

# Fifteen seconds. Small enough to keep the spacing above and to stay inside
# this run's 300-second window slice. The per-request delay is `SCRAPE_JITTER`.
RandomizedDelaySec=15s
AccuracySec=15s

# Deliberately NOT Persistent. A missed run is a slice of the window skipped,
# which the next cycle reads anyway; firing on boot would start it off-grid.
Persistent=false

[Install]
WantedBy=timers.target
