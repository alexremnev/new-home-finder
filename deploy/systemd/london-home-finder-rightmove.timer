# Rightmove, read from its own search pages.
#
# Costs about 120KB per district: one search page, every field from the
# embedded __NEXT_DATA__, no listing pages fetched at all.
#
# ── the schedule, in London time ─────────────────────────────────────────
#
#   every day  00:00–07:00   hourly
#   weekdays   08:00–18:00   every 5 minutes
#   weekdays   07:00–08:00   every 10 minutes
#   weekdays   18:00–24:00   every 10 minutes
#   weekends   07:00–24:00   every 10 minutes
#
# Five minutes through the hours London letting agents actually publish, ten
# minutes either side of them, and hourly overnight when nothing is posted but
# the watermark should still not be a whole night behind by breakfast. There is
# no dead band any more: this reader runs around the clock.
#
# Each band's stated end is exclusive, which is what makes them meet without
# firing twice. So the last five-minute run is 17:55 and the last hourly night
# run is 06:00 — 18:00 and 07:00 belong to the ten-minute band that follows.
#
# About 1060 runs a week against roughly 335 before, a little over three times
# as many; at one search page per district that is some 380MB a week with the
# three districts the seed enables, and the sweep still stops as soon as it is
# behind the watermark, so a shorter interval means less new stock above it per
# run rather than proportionally more work.
#
# ── nothing to be offset from any more ───────────────────────────────────
#
# This header used to explain why Rightmove took :00/:10/… while Zoopla sat at
# :07 and OpenRent at :14. Those two timers are disabled and deleted by
# `install.sh`, and the jobs still running — ingest, drain, rollup, report —
# are all OnUnitInactiveSec, so they drift and there is no fixed minute to
# avoid. The phase of this timer is now free, and is simply the top of the
# five-minute grid.
#
# A sweep that outlasts its interval does not pile up: systemd will not start a
# second london-home-finder@rightmove.service while the first is still running,
# it skips that trigger. TimeoutStartSec in the service is 600s.
#
# ── the zone is stated here, not taken from the machine ──────────────────
#
# Every line carries `Europe/London`. Without it systemd reads OnCalendar in
# whatever zone the machine happens to be in: the server runs on UTC, so the
# schedule would sit an hour early through British Summer Time, quietly correct
# itself in October and break again in March.
#
# Needs systemd 252 or later. Check a line with
#
#     systemd-analyze calendar 'Mon..Fri 08..17:00/5 Europe/London'

[Unit]
Description=Read Rightmove search pages, five-minutely through the working day

[Timer]
Unit=london-home-finder@rightmove.service

# Nights, every day including weekends: hourly, 00:00 to 07:00.
OnCalendar=*-*-* 00..06:00 Europe/London

# Weekdays, the working day: every five minutes, 08:00 to 18:00.
OnCalendar=Mon..Fri 08..17:00/5 Europe/London

# Weekdays, the hour before the working day and the evening after it: every ten
# minutes. Two lines because the morning band is a single hour — folded into
# `07..17` it would make 07:00–08:00 five-minutely too.
OnCalendar=Mon..Fri 07:00/10 Europe/London
OnCalendar=Mon..Fri 18..23:00/10 Europe/London

# Weekends, from the end of the night band to midnight: every ten minutes.
OnCalendar=Sat,Sun 07..23:00/10 Europe/London

# A minute and a half of jitter, so we are not on the stroke of the hour with
# everybody else's crontab. Still well inside the shortest interval, so it
# blurs a start without ever reordering two runs.
RandomizedDelaySec=90s
AccuracySec=30s

# Deliberately NOT Persistent. A run missed because the machine was off should
# be skipped rather than fired on boot: the next slot is at most an hour away
# and usually five minutes, so catching up buys nothing and a boot during the
# night band would start a sweep off-grid.
Persistent=false

[Install]
WantedBy=timers.target
