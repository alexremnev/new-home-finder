# Rightmove, read from its own search pages.
#
# Costs about 120KB per district: one search page, every field from the
# embedded __NEXT_DATA__, no listing pages fetched at all.
#
# ── the schedule, in London time ─────────────────────────────────────────
#
#   weekdays  07:20–17:00   every 10 minutes
#   weekdays  17:00–22:00   hourly
#   weekdays  22:00–07:20   not at all
#   weekends  10:00–20:00   hourly
#
# Chosen against when London letting agents actually publish, and unchanged by
# the split into three jobs. Each band's stated end is exclusive, which is what
# makes the two weekday bands meet at 17:00 without firing twice.
#
# ── why the three are offset from each other ─────────────────────────────
#
# Rightmove runs every ten minutes — :00, :10, :20, :30, :40, :50 — while
# Zoopla takes :07, :27, :47 and OpenRent :14, :34, :54. So the three still
# never land on the server in the same minute; Rightmove simply fills twice
# as many of the slots between them.
#
# Ten rather than twenty because this is the reader the whole product rests
# on while the Telegram feed is still the thing finding listings first: a
# flat is let in hours, so ten minutes of lead is worth 3MB of search pages.
# One page per district either way — the sweep stops as soon as it is behind
# the watermark, and half the interval means half as much new stock above it.
#
# The jitter below is 90 seconds against a three-minute separation, so it
# still blurs the start without letting two jobs collide.
#
# ── the zone is stated here, not taken from the machine ──────────────────
#
# Every line carries `Europe/London`. Without it systemd reads OnCalendar in
# whatever zone the machine happens to be in: the server runs on UTC, so the
# schedule would sit an hour early through British Summer Time, quietly correct
# itself in October and break again in March.
#
# Needs systemd 252 or later. Check a line with
#
#     systemd-analyze calendar 'Mon..Fri 08..16:00/10 Europe/London'

[Unit]
Description=Read Rightmove search pages on London working hours

[Timer]
Unit=london-home-finder@rightmove.service

# Weekdays, the working day. Two lines because the day does not start on the
# hour: the first covers the four runs before 08:00, the second the whole
# hours after it. Folded into one `07..16` line it would add a run at 07:00
# that the schedule deliberately excludes.
OnCalendar=Mon..Fri 07:20,30,40,50 Europe/London
OnCalendar=Mon..Fri 08..16:00/10 Europe/London
# Weekday evenings: hourly.
OnCalendar=Mon..Fri 17..21:00 Europe/London
# Weekends, a shorter day: hourly.
OnCalendar=Sat,Sun 10..19:00 Europe/London

# A minute and a half of jitter, so we are not on the stroke of the hour with
# everybody else's crontab.
RandomizedDelaySec=90s
AccuracySec=30s

# Deliberately NOT Persistent. A run missed because the machine was off should
# be skipped, not fired the moment it boots — which on a reboot at 03:00 would
# mean a sweep in the middle of the hours this schedule exists to avoid.
Persistent=false

[Install]
WantedBy=timers.target
