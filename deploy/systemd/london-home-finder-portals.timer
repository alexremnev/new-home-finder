# Rightmove, Zoopla and OpenRent, each read from its own search pages.
#
# ── why this replaces the scrape timer ──────────────────────────────────
#
# `london-home-finder-scrape.timer` runs the original OpenRent reader, which
# discovers listings from the nationwide sitemap. That sitemap carries no
# lastmod, no ETag and no Last-Modified, ignores Range, and is served
# uncompressed whatever Accept-Encoding asks for — all measured — so every run
# downloads the whole country to find out what changed in E14. About 950MB a
# day, to discover two or three listings.
#
# This job reads one search page per district instead. Measured on 26 September
# 2026, per district per run:
#
#   Rightmove    ~120KB   24 newest listings, all fields, no detail page
#   Zoopla        ~63KB   25 newest listings, all fields, no detail page
#   OpenRent      ~92KB   every id in the district, then a page per new listing
#
# So the cost now follows the districts somebody actually subscribes to rather
# than the size of the United Kingdom, and it is roughly 5MB a run for twenty
# districts against the old reader's 10MB for one.
#
# ── the schedule, in London time ─────────────────────────────────────────
#
#   weekdays  07:20–17:00   every 20 minutes   (29 runs)
#   weekdays  17:00–22:00   hourly             (5 runs)
#   weekdays  22:00–07:20   not at all
#   weekends  10:00–20:00   hourly             (10 runs)
#
# Deliberately the same shape as the old scrape timer: it was chosen against
# when London letting agents actually publish, and nothing about reading a
# different page changes that. Each band's stated end is exclusive, which is
# what makes the two weekday bands meet at 17:00 without firing twice — so the
# last twenty-minute run is 16:40 and the last evening run is 21:00.
#
# ── the zone is stated here, not taken from the machine ──────────────────
#
# Every line carries `Europe/London`. Without it systemd reads OnCalendar in
# whatever zone the machine happens to be in: the server runs on UTC, so the
# whole schedule would sit an hour early through British Summer Time and would
# quietly correct itself in October and break again in March.
#
# Needs systemd 252 or later. Check a line with
#
#     systemd-analyze calendar 'Mon..Fri 08..16:00/20 Europe/London'
#
# which prints the next elapse in UTC — an hour behind the London time asked
# for while BST is in force, and equal to it in winter.
[Unit]
Description=Read Rightmove, Zoopla and OpenRent search pages on London working hours

[Timer]
Unit=london-home-finder@portals.service

# Weekdays, the working day: every twenty minutes from 07:20.
#
# Two lines rather than one because the day does not start on the hour: the
# first covers 07:20 and 07:40, the second the whole hours after it. Written as
# `07..16:00/20` it would have added a run at 07:00 that nobody asked for.
OnCalendar=Mon..Fri 07:20,40 Europe/London
OnCalendar=Mon..Fri 08..16:00/20 Europe/London
# Weekday evenings: hourly.
OnCalendar=Mon..Fri 17..21:00 Europe/London
# Weekends, a shorter day: hourly.
OnCalendar=Sat,Sun 10..19:00 Europe/London

# A minute and a half of jitter, so we are not on the stroke of the hour with
# everybody else's crontab.
RandomizedDelaySec=90s
AccuracySec=30s

# Deliberately NOT Persistent. A run missed because the machine was off should
# be skipped, not fired the moment it boots — which on a reboot at 03:00 would
# mean a sweep in the middle of the hours this schedule exists to avoid.
Persistent=false

[Install]
WantedBy=timers.target
