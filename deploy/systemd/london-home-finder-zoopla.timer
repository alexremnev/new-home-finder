# Zoopla, read from its own search pages.
#
# Costs about 63KB per district, half of Rightmove's: the listings come from
# the page's React Server Components stream, and only the array holding the
# district's own results is read.
#
# ── the schedule, in London time ─────────────────────────────────────────
#
#   weekdays  07:20–17:00   every 20 minutes
#   weekdays  17:00–22:00   hourly
#   weekdays  22:00–07:20   not at all
#   weekends  10:00–20:00   hourly
#
# Chosen against when London letting agents actually publish, and unchanged by
# the split into three jobs. Each band's stated end is exclusive, which is what
# makes the two weekday bands meet at 17:00 without firing twice.
#
# ── why the three are offset from each other ─────────────────────────────
#
# Zoopla runs at seven minutes past — :07, :27, :47. Rightmove takes the top of the
# interval, Zoopla seven minutes later, OpenRent fourteen — so the three sweeps
# never land on the server in the same minute. Each still gets a full sweep
# every twenty minutes; only the phase differs.
#
# The jitter below is 90 seconds against a seven-minute separation, so it
# blurs the start without letting two jobs collide.
#
# ── the zone is stated here, not taken from the machine ──────────────────
#
# Every line carries `Europe/London`. Without it systemd reads OnCalendar in
# whatever zone the machine happens to be in: the server runs on UTC, so the
# schedule would sit an hour early through British Summer Time, quietly correct
# itself in October and break again in March.
#
# Needs systemd 252 or later. Check a line with
#
#     systemd-analyze calendar 'Mon..Fri 08..16:07/20 Europe/London'

[Unit]
Description=Read Zoopla search pages on London working hours

[Timer]
Unit=london-home-finder@zoopla.service

# Weekdays, the working day. Two lines because the day does not start on the
# hour: the first covers the two runs before 08:00, the second the whole hours
# after it. Folded into one `07..16` line it would add a run at 07:00 that the
# schedule deliberately excludes.
OnCalendar=Mon..Fri 07:27,47 Europe/London
OnCalendar=Mon..Fri 08..16:07/20 Europe/London
# Weekday evenings: hourly.
OnCalendar=Mon..Fri 17..21:07 Europe/London
# Weekends, a shorter day: hourly.
OnCalendar=Sat,Sun 10..19:07 Europe/London

# A minute and a half of jitter, so we are not on the stroke of the hour with
# everybody else's crontab.
RandomizedDelaySec=90s
AccuracySec=30s

# Deliberately NOT Persistent. A run missed because the machine was off should
# be skipped, not fired the moment it boots — which on a reboot at 03:00 would
# mean a sweep in the middle of the hours this schedule exists to avoid.
Persistent=false

[Install]
WantedBy=timers.target
