[Unit]
Description=London Home Finder: mint a Cloudflare clearance token
After=network-online.target
Wants=network-online.target
# Deliberately NOT OnFailure=london-home-finder-alert@. A mint that fails
# leaves the readers exactly where they were before this unit existed — being
# challenged — and the next attempt is twenty-five minutes away. Waking
# somebody for it would be waking them for a degradation they already have a
# dashboard for. The Host tab's mint rate is where this is read.

[Service]
Type=oneshot
User=finder
Slice=london-home-finder-browser.slice
WorkingDirectory=/opt/london-home-finder
EnvironmentFile=/etc/london-home-finder.env
ExecStart=/opt/london-home-finder/.venv/bin/python -m worker clearance --trigger schedule
# Sixty seconds of browser plus room to start one, against the job's own
# TIMEOUT_MS of 60s. Much shorter than the readers' 600: this unit opens one
# page, and one that is still trying after two minutes is one whose exit is not
# going to answer.
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# The same state directory the readers use, and that is the entire point: the
# jar this writes is the jar `Fetcher._handle` reads. A private one here would
# mint a token into a file nothing presents.
StateDirectory=london-home-finder
StateDirectoryMode=0700
