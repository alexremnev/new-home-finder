# Copy to .env beside this file. Nothing here is shared with the scraper's .env:
# the values may be the same, but the files stay separate so neither tool can
# break the other by changing one.

# From https://my.telegram.org → API development tools. This identifies the
# *application*, not you, and it is not a bot token.
TG_API_ID=
TG_API_HASH=

# Printed by `python mirror.py login`. A live login to your account: anyone
# holding it is signed in as you, with no password and no code. Never commit it;
# revoke it in Telegram → Settings → Devices if it leaks.
TG_SESSION=

# Whose messages to copy, without the @. Comma-separated for more than one.
# Required: there is deliberately no default in the code.
TG_WATCH=

# Optional. Wording to replace on the way through, as pattern=>replacement,
# several separated by ;;. Regular expressions, case-insensitive.
TG_REWRITES=

# Where the copies go. Your own chat id works; a private group you own works too.
# Find yours by messaging @userinfobot.
TG_DEST_CHAT=

# Your own bot, from @BotFather → /mybots → API Token. Needed for the default
# --via bot. Not needed for --via forward, which sends as you.
TG_DEST_BOT_TOKEN=
