# Secrets. These lines are load-bearing: without them `git add -A` commits the
# real .env, and a password in git history is compromised even in a private repo.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.vercel/

# Local snapshots of fetched pages (debug artifacts, may be large)
snapshots/

# IDE
.idea/
.vscode/
.DS_Store
