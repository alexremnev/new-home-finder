# Secrets. These lines are load-bearing: without them `git add -A` commits the
# real .env, and a password in git history is compromised even in a private repo.
.env
.env.*
!.env.example
*.pem
*.key

# Telegram user sessions for tools/tg-mirror. A session is a live login, not a
# credential that can be rotated quietly: whoever holds one is signed in as you,
# with no password and no code. Its cursor file is local bookkeeping, not shared.
*.session
*.session-journal
tools/tg-mirror/state.json
tools/tg-mirror/state.json.tmp
tools/tg-mirror/logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.vercel/

# Local snapshots of fetched pages (debug artifacts, may be large)
snapshots/

# IDE
.idea/
.vscode/
.DS_Store
